{
  "name": "@diametral/ui",
  "version": "0.3.1",
  "type": "module",
  "description": "Diametral Design System — React components on Base UI and Tailwind v4. Flat, 1px, no radius, no shadows.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "base-ui",
    "tailwindcss",
    "diametral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diamorval/design-system-diametral.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "//": "pnpm swaps these fields in at pack time. Source stays the entry point in-repo so the docs app keeps HMR on component edits; the tarball resolves to dist. Public paths are flat (diametral-ds, diametral-ds/button, diametral-ds/assets/*) — the src/ folder layout is not API. The name itself is swapped to diametral-ds by the publish workflow.",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.compiled.css",
      "./styles.tailwind.css": "./dist/globals.css",
      "./assets/*": "./dist/assets/*",
      "./package.json": "./package.json",
      "./*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/build-entry.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint && node scripts/lint-components.mjs",
    "lint:components": "node scripts/lint-components.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "peerDependencies": {
    "@shadcn/react": "^0.2.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@shadcn/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-day-picker": "^10.0.1",
    "react-is": "^18.0.0 || ^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20"
  }
}
