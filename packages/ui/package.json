{
  "name": "@diametral/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Diametral Design System — React components on Base UI and Tailwind v4. Flat, 1px, no radius, no shadows.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "base-ui",
    "tailwindcss",
    "diametral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBigCode/design-system2.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "//": "pnpm swaps these fields in at pack time. Source stays the entry point in-repo so the docs app keeps HMR on component edits; the tarball resolves to dist.",
    "exports": {
      "./globals.css": "./dist/globals.css",
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint && node scripts/lint-components.mjs",
    "lint:components": "node scripts/lint-components.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20"
  }
}
